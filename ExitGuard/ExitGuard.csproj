<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tiny helper the plugin embeds and starts; see Program.cs. 32-bit to load the same vJoyInterface.dll as SimHub. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SimsonnPedalsExitGuard</AssemblyName>
    <RootNamespace>SimsonnPedals.ExitGuard</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

</Project>
