<UserControl x:Class="SimsonnPedals.UI.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:styles="clr-namespace:SimHub.Plugins.Styles;assembly=SimHub.Plugins"
             xmlns:local="clr-namespace:SimsonnPedals.UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <styles:SHSection Title="SIMSONN PRO X ULTRA" ShowSeparator="True">
                    <StackPanel>
                        <TextBlock x:Name="DeviceStatusText" FontWeight="SemiBold" />
                        <TextBlock x:Name="VJoyStatusText" Margin="0,2,0,0" />
                        <TextBlock x:Name="RawAxesText" Margin="0,2,0,0" Opacity="0.6" FontFamily="Consolas" />
                        <styles:SHButtonSecondary HorizontalAlignment="Left" Margin="0,6,0,0" Click="OnReconnectClick"
                                                  ToolTip="Close and reopen the pedals, as if the USB cable had been replugged">Reconnect pedals</styles:SHButtonSecondary>
                        <TextBlock Margin="0,6,0,0" Opacity="0.7" TextWrapping="Wrap"
                                   Text="Bind throttle and brake to the vJoy device in iRacing. Set the pedals to a linear curve, 0 dead zone and no filter in Simsonn Manager so the shaping isn't applied twice." />
                    </StackPanel>
                </styles:SHSection>
                <local:GifImage Grid.Column="1" ResourceName="SimsonnPedals.header.gif" Width="112" Height="112"
                                VerticalAlignment="Top" Margin="12,4,8,0" />
            </Grid>

            <styles:SHSection Title="PRESETS" ShowSeparator="True">
                <StackPanel>
                    <WrapPanel>
                        <TextBlock Text="Active preset" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="PresetCombo" Width="200" SelectionChanged="OnPresetSelected" Margin="0,0,8,0" />
                        <styles:SHButtonSecondary x:Name="DeleteButton" Click="OnDeleteClick">Delete</styles:SHButtonSecondary>
                        <styles:SHButtonPrimary x:Name="SaveButton" Click="OnSaveClick"
                                                ToolTip="Keep the current values; Revert comes back to them">Save</styles:SHButtonPrimary>
                        <styles:SHButtonSecondary x:Name="RevertButton" Click="OnRevertClick"
                                                  ToolTip="Go back to this preset's last Save">Revert</styles:SHButtonSecondary>
                    </WrapPanel>
                    <TextBlock x:Name="ModifiedText" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#FFE0A030" />
                    <WrapPanel Margin="0,8,0,0">
                        <TextBlock Text="Save as" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="NewPresetName" Width="200" VerticalContentAlignment="Center" Margin="0,0,8,0" />
                        <styles:SHButtonSecondary Click="OnSaveAsClick">Save as</styles:SHButtonSecondary>
                        <styles:SHButtonSecondary x:Name="SaveForGameButton" Click="OnSaveForGameClick">Save for current game</styles:SHButtonSecondary>
                    </WrapPanel>
                    <styles:SHToggleCheckbox x:Name="AutoApplyToggle" Margin="0,8,0,0" Click="OnAutoApplyClick">
                        Switch preset automatically when the game changes (falls back to Default)
                    </styles:SHToggleCheckbox>
                    <WrapPanel Margin="0,8,0,0">
                        <TextBlock Text="vJoy device" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="VJoyDeviceCombo" Width="60" SelectionChanged="OnVJoyDeviceChanged" />
                    </WrapPanel>
                </StackPanel>
            </styles:SHSection>

            <styles:SHSection Title="PEDAL FIRMWARE SETTINGS" ShowSeparator="True">
                <StackPanel>
                    <TextBlock Opacity="0.7" TextWrapping="Wrap"
                               Text="Read downloads the settings stored in the pedals to a file, without changing anything. The pedals stop responding for about 2 seconds while it runs, so don't use it while driving." />
                    <WrapPanel Margin="0,8,0,0">
                        <TextBlock Text="Label (optional)" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="DumpLabel" Width="220" VerticalContentAlignment="Center" Margin="0,0,8,0"
                                 ToolTip="Describe the one change you made, e.g. brake deadzone start 10" />
                        <styles:SHButtonSecondary x:Name="ReadPedalSettingsButton" Click="OnReadPedalSettingsClick">Read pedal settings</styles:SHButtonSecondary>
                        <styles:SHButtonSecondary Click="OnOpenDumpFolderClick">Open folder</styles:SHButtonSecondary>
                    </WrapPanel>
                    <WrapPanel Margin="0,8,0,0">
                        <TextBlock Text="Brake max force in the pedals (kg)" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="SetupMaxForceBox" Width="60" VerticalContentAlignment="Center" Margin="0,0,8,0"
                                 ToolTip="Force at which the pedals report 100% brake. Set it above your hardest press; choose your real 100% with the brake panel's '100% at'." />
                        <styles:SHButtonPrimary x:Name="SetupPedalsButton" Click="OnSetupPedalsClick"
                                                ToolTip="Writes linear curves, no dead zone, filter off and this max force to the pedals, so all shaping happens here">Set up pedals</styles:SHButtonPrimary>
                    </WrapPanel>
                    <WrapPanel Margin="0,8,0,0">
                        <styles:SHButtonPrimary x:Name="CalibratePedalsButton" Click="OnCalibratePedalsClick"
                                                ToolTip="Calibrates the pedals themselves (rest and full press), like Simsonn Manager's Calibrate, then sets them up like Set up pedals">Calibrate pedals</styles:SHButtonPrimary>
                        <styles:SHButtonPrimary x:Name="CalibrationStartButton" Click="OnCalibrationStartClick" Visibility="Collapsed">Start</styles:SHButtonPrimary>
                        <styles:SHButtonPrimary x:Name="CalibrationFinishButton" Click="OnCalibrationFinishClick" Visibility="Collapsed">Finish</styles:SHButtonPrimary>
                        <styles:SHButtonSecondary x:Name="CalibrationCancelButton" Click="OnCalibrationCancelClick" Visibility="Collapsed">Cancel</styles:SHButtonSecondary>
                        <TextBlock x:Name="CalibrationLive" VerticalAlignment="Center" Margin="8,0,0,0" FontFamily="Consolas" />
                    </WrapPanel>
                    <WrapPanel Margin="0,8,0,0">
                        <styles:SHButtonSecondary x:Name="RewriteTestButton" Click="OnRewriteTestClick"
                                                  ToolTip="Reads the settings, writes the same bytes back to the pedals and checks them. Changes nothing.">Rewrite test</styles:SHButtonSecondary>
                        <TextBlock VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap" Margin="4,0,0,0"
                                   Text="Tests writing to the pedals by saving their own settings back unchanged. Close Simsonn Manager first." />
                    </WrapPanel>
                    <TextBlock x:Name="PedalSettingsStatus" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </styles:SHSection>

            <styles:SHSection Title="PEDAL FIRMWARE" ShowSeparator="True">
                <StackPanel>
                    <TextBlock Opacity="0.7" TextWrapping="Wrap"
                               Text="Updates the pedals' firmware with the files and key from your Simsonn Manager install, the same way the Manager does. Close Simsonn Manager and the game first, and don't unplug the pedals while it runs (about a minute)." />
                    <WrapPanel Margin="0,8,0,0">
                        <styles:SHButtonSecondary x:Name="CheckFirmwareButton" Click="OnCheckFirmwareClick"
                                                  ToolTip="Reads the firmware version from the pedals and lists the firmware files Simsonn Manager has for them. Changes nothing.">Check firmware</styles:SHButtonSecondary>
                        <styles:SHButtonSecondary x:Name="ChooseManagerButton" Click="OnChooseManagerClick"
                                                  ToolTip="Point the plugin at SIMSONN Manager.exe if it wasn't found">Find Simsonn Manager…</styles:SHButtonSecondary>
                    </WrapPanel>
                    <WrapPanel Margin="0,8,0,0">
                        <TextBlock Text="Firmware" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="FirmwareCombo" Width="340" Margin="0,0,8,0" />
                        <styles:SHButtonPrimary x:Name="UpdateFirmwareButton" Click="OnUpdateFirmwareClick" IsEnabled="False">Update firmware</styles:SHButtonPrimary>
                    </WrapPanel>
                    <TextBlock x:Name="FirmwareStatus" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </styles:SHSection>

            <styles:SHSection Title="PLUGIN UPDATES" ShowSeparator="True">
                <StackPanel>
                    <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,8,0,0">
                        <styles:SHButtonSecondary x:Name="CheckUpdatesButton" Click="OnCheckUpdatesClick">Check for updates</styles:SHButtonSecondary>
                        <styles:SHButtonPrimary x:Name="InstallUpdateButton" Click="OnInstallUpdateClick" Visibility="Collapsed">Update</styles:SHButtonPrimary>
                        <styles:SHButtonPrimary x:Name="RestartButton" Click="OnRestartClick" Visibility="Collapsed">Restart SimHub</styles:SHButtonPrimary>
                        <styles:SHButtonSecondary x:Name="ReleaseNotesButton" Click="OnReleaseNotesClick">Release notes</styles:SHButtonSecondary>
                    </WrapPanel>
                </StackPanel>
            </styles:SHSection>

            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <local:PedalPanel x:Name="BrakePanel" Title="Brake" ShowMaxForce="True" />
                <local:PedalPanel x:Name="ThrottlePanel" Grid.Column="1" Title="Throttle" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
